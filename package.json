{
  "name": "rsstg",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0"
  },
  "scripts": {
    "deploy": "tgcloud push",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "poll": "tgcloud run endpoints/poll '{}'",
    "poll:daemon": "node scripts/poll_runner.js",
    "cf:deploy": "npx wrangler deploy",
    "cf:dev": "npx wrangler dev --test-scheduled",
    "cf:tail": "npx wrangler tail",
    "cf:secret": "npx wrangler secret put TGCLOUD_TOKEN",
    "test": "node --test"
  }
}
